{
  "name": "stemify-desktop",
  "version": "1.5.0",
  "description": "Stemify - The Audio Splitter (Desktop App)",
  "author": "huchukato",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "backend:bundle": "cd .. && uv run --with pyinstaller pyinstaller packaging/backend_entry.py --name stemify-backend --onefile --noconfirm --distpath backend-dist --workpath backend-build --paths demucs-backend --collect-submodules demucs --collect-data demucs --collect-submodules librosa --collect-data librosa",
    "electron-build": "npm run build && npm run backend:bundle && electron-builder",
    "build": "vite build"
  },
  "build": {
    "appId": "com.stemify.app",
    "productName": "Stemify",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "../backend-dist",
        "to": "."
      }
    ],
    "mac": {
      "icon": "icons/icon.icns",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "icons/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.0.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "wait-on": "^7.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.3",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
}
